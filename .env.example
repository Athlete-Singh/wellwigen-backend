PORT=8000
NODE_ENV=development

# MongoDB Atlas Database URI (or local fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wellwigen?retryWrites=true&w=majority

# JWT & HMAC Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
OTP_HMAC_SECRET=your_super_secret_otp_hmac_key_here

# Gmail SMTP Configuration for Email OTP (Port 465 SSL/TLS)
# IMPORTANT: Use a 16-character Google App Password (NOT your personal Google account password)
GMAIL_USER=your-organization-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:5177,https://wellwigen.com

# Optional Redis Cache / Queue
REDIS_URL=redis://127.0.0.1:6379
